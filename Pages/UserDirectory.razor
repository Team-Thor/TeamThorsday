@page "/users"
@using Team_Thorsday.ViewModels
@inject UserDirectoryViewModel ViewModel

<h3>Database Connection Test</h3>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card p-3">
            <h5>Add Test User</h5>
            <div class="input-group mb-2">
                <input @bind="ViewModel.NewUser.FirstName" class="form-control" placeholder="First Name" />
                <input @bind="ViewModel.NewUser.LastName" class="form-control" placeholder="Last Name" />
            </div>
            <input @bind="ViewModel.NewUser.Email" class="form-control mb-2" placeholder="Email" />
            <button class="btn btn-primary" @onclick="HandleAddUser">Add to Supabase</button>
            <p class="text-danger mt-2">@ViewModel.ErrorMessage</p>
        </div>
    </div>
</div>

<ul class="nav nav-tabs">
    <li class="nav-item">
        <a class="nav-link @(ViewModel.ActiveTab == "table" ? "active" : "")" @onclick='() => ViewModel.ActiveTab = "table"' style="cursor:pointer">Visual Table</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewModel.ActiveTab == "json" ? "active" : "")" @onclick='() => ViewModel.ActiveTab = "json"' style="cursor:pointer">Raw JSON (Debug)</a>
    </li>
</ul>

@if (ViewModel.IsLoading)
{
    <p><em>Connecting to Supabase...</em></p>
}
else if (ViewModel.ActiveTab == "table")
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in ViewModel.Users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        <button class="btn btn-sm btn-secondary" @onclick="() => HandleGenerateKey(user.Id)">Generate Key</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-3 p-3 bg-light border">
        <pre>@ViewModel.RawJson</pre>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadDataAsync();
    }

    private async Task HandleAddUser()
    {
        await ViewModel.AddUserAsync();
    }

    private async Task HandleGenerateKey(int userId)
    {
        await ViewModel.GenerateKeyAsync(userId);
    }
}