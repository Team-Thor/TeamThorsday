@page "/dashboard"
@page "/"
@using Team_Thorsday.Models
@using Shared.DTOs
@using System.Text.Json
<!-- Service that fetches data from backend APIs -->
@inject SteamDashboardService DashboardService
<!-- Used to save/load filter settings from browser localStorage -->
@inject IJSRuntime JS                             

<div class="dashboard-container">
    <h1 class="dashboard-title">SteamDB Dashboard</h1>

    <!-- Toolbar with chart toggle and filter button -->
    <div class="dashboard-toolbar">
        <button class="btn btn-gradient-border px-4" @onclick="ToggleGraph">
            <span class="me-2">&#9776;</span> @(showGraph ? "Hide Charts" : "Show Charts")
        </button>

        <div class="filter-dropdown-wrapper">
            <button class="btn btn-gradient-border px-4" @onclick="ToggleFilters">
                &#9881; Filters @(showFilters ? "▲" : "▼")
            </button>

            <!-- Filter panel (shown when showFilters is true) -->
            @if (showFilters)
            {
                <div class="filter-panel">
                    <div class="filter-row">
                        <div class="filter-section">
                            <div class="filter-section-title">Content</div>
                            <label class="filter-option">
                                <input type="checkbox" checked="@hideAdultContent"
                                       @onchange="e => hideAdultContent = (bool)e.Value!" />
                                Hide 18+ titles
                            </label>
                        </div>

                        <div class="filter-section">
                            <div class="filter-section-title">Game Type</div>
                            <div class="filter-radio-group">
                                @foreach (var (val, lbl) in new[] { ("all","All"), ("free","Free"), ("paid","Paid") })
                                {
                                    <label class="filter-radio @(gameType == val ? "active" : "")"
                                           @onclick="() => gameType = val">@lbl</label>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Additional filter sections for review score, review count, peak CCU, etc. -->
                    <div class="filter-row">
                        <div class="filter-section">
                            <div class="filter-section-title">Min Review Score</div>
                            <div class="filter-radio-group">
                                @foreach (var (val, lbl) in new[] { (0,"Any"), (70,"70%+"), (80,"80%+"), (90,"90%+") })
                                {
                                    <label class="filter-radio @(minReviewScore == val ? "active" : "")"
                                           @onclick="() => minReviewScore = val">@lbl</label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="filter-row">
                        <div class="filter-section">
                            <div class="filter-section-title">Min Review Count</div>
                            <div class="filter-radio-group">
                                @foreach (var (val, lbl) in new[] { (0,"Any"), (100,"100+"), (1000,"1k+"), (10000,"10k+") })
                                {
                                    <label class="filter-radio @(minReviewCount == val ? "active" : "")"
                                           @onclick="() => minReviewCount = val">@lbl</label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="filter-row">
                        <div class="filter-section">
                            <div class="filter-section-title">Min Peak CCU</div>
                            <div class="filter-radio-group">
                                @foreach (var (val, lbl) in new[] { (0,"Any"), (1000,"1k+"), (10000,"10k+"), (100000,"100k+") })
                                {
                                    <label class="filter-radio @(minCcu == val ? "active" : "")"
                                           @onclick="() => minCcu = val">@lbl</label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="filter-divider"></div>

                    <!-- Settings for how many items appear in tiles vs charts -->
                    <div class="filter-row">
                        <div class="filter-section">
                            <div class="filter-section-title">Results per Tile</div>
                            <div class="filter-radio-group">
                                @foreach (var n in new[] { 5, 10 })
                                {
                                    <label class="filter-radio @(previewCount == n ? "active" : "")"
                                           @onclick="() => previewCount = n">@n</label>
                                }
                            </div>
                        </div>

                        <div class="filter-section">
                            <div class="filter-section-title">Results in Chart</div>
                            <div class="filter-radio-group">
                                @foreach (var n in new[] { 10, 15, 20 })
                                {
                                    <label class="filter-radio @(chartCount == n ? "active" : "")"
                                           @onclick="() => chartCount = n">@n</label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="filter-divider"></div>

                    <!-- Applies current filters and saves them to localStorage -->
                    <button class="filter-apply-btn" @onclick="ApplyAndSave">Apply &amp; Save</button>
                </div>
            }
        </div>
    </div>

    <!-- Backdrop to close filter panel when clicking outside -->
    @if (showFilters)
    {
        <div class="filter-backdrop" @onclick="() => showFilters = false"></div>
    }

    <!-- Optional large graph component at the top -->
    @if (showGraph)
    {
        <GraphView TopGames="filteredGames" Genres="genres" ChartCount="chartCount" />
    }

    <!-- Main dashboard grid of clickable tiles -->
    <div class="dashboard-grid">
        @foreach (var tile in tiles)
        {
            <Tile TileData="tile" OnTileClicked="() => OpenModal(tile)" />
        }
    </div>
</div>

<!-- Modal for selected tile -->
@if (selectedTile != null)
{
    <TileModal TileData="selectedTile" OnClose="() => selectedTile = null" />
}

@code {
    /// <summary>
    /// Static list of dashboard tiles. Each tile defines its title, subtitle, and what data it displays.
    /// </summary>
    private List<TileInfo> tiles = new()
    {
        new TileInfo { Id = 1, Title = "Most Played This Week", Subtitle = "Top games by ownership",    ValueHeader = "Owners" },
        new TileInfo { Id = 2, Title = "Concurrent Players",    Subtitle = "Peak CCU yesterday",        ValueHeader = "Peak CCU" },
        new TileInfo { Id = 3, Title = "Price by Genre",        Subtitle = "Avg price per genre",       ValueHeader = "Avg Price" },
        new TileInfo { Id = 4, Title = "New Releases",          Subtitle = "Latest on Steam",           ValueHeader = "Price" },
        new TileInfo { Id = 5, Title = "Most Time Played",      Subtitle = "Top games by avg playtime", ValueHeader = "Avg Playtime" },
        new TileInfo { Id = 6, Title = "Top Reviewed",          Subtitle = "Highest positive review %", ValueHeader = "Score" }
    };

    // Data fetched from backend
    private List<SteamSpyGameDto> topGames     = new();
    private List<SteamSpyGameDto> newGames     = new();
    private List<GenreStatsDto>   genres       = new();
    private List<SteamSpyGameDto> filteredGames = new();

    // Filter state (persisted to localStorage)
    private bool   hideAdultContent = true;
    private string gameType         = "all";
    private int    minReviewScore   = 0;
    private int    minReviewCount   = 0;
    private int    minCcu           = 0;
    private int    previewCount     = 5;     // Items shown in each tile preview
    private int    chartCount       = 15;    // Items shown in the graph

    private TileInfo? selectedTile;
    private bool showGraph   = false;
    private bool showFilters = false;

    private void OpenModal(TileInfo tile) => selectedTile = tile;
    private void ToggleGraph()   => showGraph   = !showGraph;
    private void ToggleFilters() => showFilters = !showFilters;

    /// <summary>
    /// Applies current filters, refreshes tile data, and saves settings to browser localStorage.
    /// </summary>
    private async Task ApplyAndSave()
    {
        ApplyFilters();
        await JS.InvokeVoidAsync("saveFilterSettings", new
        {
            hideAdultContent, gameType, minReviewScore, minReviewCount,
            minCcu, previewCount, chartCount
        });
        showFilters = false;
    }

    /// <summary>
    /// Applies all active filters to the topGames list and stores the result in filteredGames.
    /// Then refreshes all tiles with the filtered data.
    /// </summary>
    private void ApplyFilters()
    {
        var games = topGames.AsEnumerable();

        // Filter out adult content based on tags
        if (hideAdultContent)
            games = games.Where(IsClean);

        // Filter by free / paid / all
        games = gameType switch
        {
            "free" => games.Where(g => g.Price == "0" || g.Price == ""),
            "paid" => games.Where(g => g.Price != "0" && g.Price != ""),
            _      => games
        };

        // Filter by minimum review score percentage
        if (minReviewScore > 0)
            games = games.Where(g =>
                g.Positive + g.Negative > 0 &&
                (double)g.Positive / (g.Positive + g.Negative) * 100 >= minReviewScore);

        if (minReviewCount > 0)
            games = games.Where(g => g.Positive + g.Negative >= minReviewCount);

        if (minCcu > 0)
            games = games.Where(g => g.PeakConcurrentUsersYesterday >= minCcu);

        filteredGames = games.ToList();
        PopulateTiles();
    }

    /// <summary>
    /// Set of adult/NSFW tags used to filter out mature content.
    /// </summary>
    private static readonly HashSet<string> AdultTags = new(StringComparer.OrdinalIgnoreCase)
    {
        "Nudity", "Sexual Content", "Adult Content", "NSFW", "Hentai",
        "Eroge", "Adult Only", "Explicit Sexual Content"
    };

    private static bool IsClean(SteamSpyGameDto g) =>
        !g.Tags.Keys.Any(t => AdultTags.Contains(t));

    /// <summary>
    /// Page initialization: loads saved filters, fetches data from backend in parallel,
    /// applies filters, and populates all tiles.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadFilters();

        string? topError = null, newError = null, genreError = null;

        // Fetch multiple datasets in parallel for better performance
        await Task.WhenAll(
            SafeFetch(() => DashboardService.GetTopGamesAsync(),    v => topGames = v, e => topError   = e),
            SafeFetch(() => DashboardService.GetNewReleasesAsync(), v => newGames = v, e => newError   = e),
            SafeFetch(() => DashboardService.GetGenreStatsAsync(),  v => genres   = v, e => genreError = e)
        );

        // Set error messages on affected tiles
        if (topError != null)
        {
            foreach (var i in new[] { 0, 1, 4, 5 })
            { tiles[i].ErrorMessage = topError; tiles[i].IsLoading = false; }
        }
        if (genreError != null) { tiles[2].ErrorMessage = genreError; tiles[2].IsLoading = false; }
        if (newError   != null) { tiles[3].ErrorMessage = newError;   tiles[3].IsLoading = false; }

        ApplyFilters();
        StateHasChanged();
    }

    /// <summary>
    /// Loads previously saved filter settings from browser localStorage via JavaScript interop.
    /// Falls back to default values if nothing is saved or if reading fails.
    /// </summary>
    private async Task LoadFilters()
    {
        try
        {
            var el = await JS.InvokeAsync<JsonElement?>("loadFilterSettings");
            if (el is not JsonElement e || e.ValueKind != JsonValueKind.Object) return;

            if (e.TryGetProperty("hideAdultContent", out var v)) hideAdultContent = v.GetBoolean();
            if (e.TryGetProperty("gameType",         out v))     gameType         = v.GetString() ?? "all";
            if (e.TryGetProperty("minReviewScore",   out v))     minReviewScore   = v.GetInt32();
            if (e.TryGetProperty("minReviewCount",   out v))     minReviewCount   = v.GetInt32();
            if (e.TryGetProperty("minCcu",           out v))     minCcu           = v.GetInt32();
            if (e.TryGetProperty("previewCount",     out v))     previewCount     = v.GetInt32();
            if (e.TryGetProperty("chartCount",       out v))     chartCount       = v.GetInt32();
        }
        catch { /* use defaults if localStorage read fails */ }
    }

    /// <summary>
    /// Takes the filtered data and distributes it into each tile's PreviewItems and FullItems lists.
    /// </summary>
    private void PopulateTiles()
    {
        var top = filteredGames;

        PopulateTile(tiles[0],
            top.Take(previewCount).Select(g => new TileItem(g.Name, g.Owners)).ToList(),
            top.Take(20).Select(g => new TileItem(g.Name, g.Owners)).ToList());

        var byCcu = top.OrderByDescending(g => g.PeakConcurrentUsersYesterday).ToList();
        PopulateTile(tiles[1],
            byCcu.Take(previewCount).Select(g => new TileItem(g.Name, $"{g.PeakConcurrentUsersYesterday:N0}")).ToList(),
            byCcu.Take(20).Select(g => new TileItem(g.Name, $"{g.PeakConcurrentUsersYesterday:N0}")).ToList());

        var byPrice = genres.OrderByDescending(g => g.AvgPriceUsd).ToList();
        PopulateTile(tiles[2],
            byPrice.Take(previewCount).Select(g => new TileItem(g.Genre, $"${g.AvgPriceUsd:F2}")).ToList(),
            byPrice.Select(g => new TileItem(g.Genre, $"${g.AvgPriceUsd:F2} ({g.GameCount} games)")).ToList());

        PopulateTile(tiles[3],
            newGames.Take(previewCount).Select(g => new TileItem(g.Name, FormatPrice(g.Price))).ToList(),
            newGames.Take(20).Select(g => new TileItem(g.Name, FormatPrice(g.Price))).ToList());

        var byPlaytime = top.OrderByDescending(g => g.AveragePlaytimeMinutes).ToList();
        PopulateTile(tiles[4],
            byPlaytime.Take(previewCount).Select(g => new TileItem(g.Name, $"{g.AveragePlaytimeMinutes / 60}h avg")).ToList(),
            byPlaytime.Take(20).Select(g => new TileItem(g.Name, $"{g.AveragePlaytimeMinutes / 60}h avg")).ToList());

        var byReviews = top
            .Where(g => g.Positive + g.Negative > 0)
            .OrderByDescending(g => (double)g.Positive / (g.Positive + g.Negative))
            .ToList();
        PopulateTile(tiles[5],
            byReviews.Take(previewCount).Select(g => new TileItem(g.Name, $"{(double)g.Positive / (g.Positive + g.Negative) * 100:F0}%")).ToList(),
            byReviews.Take(20).Select(g => new TileItem(g.Name, $"{(double)g.Positive / (g.Positive + g.Negative) * 100:F0}%")).ToList());
    }

    private static void PopulateTile(TileInfo tile, List<TileItem> preview, List<TileItem> full)
    {
        tile.PreviewItems = preview;
        tile.FullItems    = full;
        tile.IsLoading    = false;
    }

    private static string FormatPrice(string price) =>
        !string.IsNullOrEmpty(price) && price != "0" && int.TryParse(price, out var cents)
            ? $"${cents / 100.0:F2}" : "Free";

    /// <summary>
    /// Helper method to safely fetch data and handle exceptions without crashing the page.
    /// </summary>
    private static async Task SafeFetch<T>(Func<Task<T?>> fetch, Action<T> onSuccess, Action<string> onError) where T : class
    {
        try
        {
            var result = await fetch();
            if (result != null) onSuccess(result);
            else onError("No data returned");
        }
        catch (Exception ex)
        {
            onError(ex.Message);
        }
    }
}