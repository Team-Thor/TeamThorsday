@using Team_Thorsday.Models

@if (TileData != null)
{
    <div class="steam-modal-backdrop" @onclick="OnCloseClicked">
        <div class="steam-modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@TileData.Title</h2>
                <button class="close-btn" @onclick="OnCloseClicked">✕</button>
            </div>

            <p class="modal-subtitle">@TileData.Subtitle</p>

            <div class="modal-table-wrapper">
                @if (TileData.IsLoading)
                {
                    <div class="tile-loading">Loading...</div>
                }
                else if (TileData.FullItems.Count == 0)
                {
                    <p class="text-muted">No data available.</p>
                }
                else
                {
                    <table class="table table-sm steam-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>@TileData.ValueHeader</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int rank = 1;}
                            @foreach (var item in TileData.FullItems)
                            {
                                <tr>
                                    <td>@rank</td>
                                    <td>@item.Label</td>
                                    <td>@item.Value</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="modal-actions">
                <button class="close-btn" @onclick="OnCloseClicked">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public TileInfo TileData { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task OnCloseClicked()
    {
        await OnClose.InvokeAsync();
    }
}
