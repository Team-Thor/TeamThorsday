@using Team_Thorsday.Models

<!-- Individual Dashboard Tile Component -->
<!-- Displays a single card with title, subtitle, and a short list of data items -->
<!-- Clickable - opens a modal with more details when clicked -->

<div class="steam-tile" @onclick="HandleClick">
    <div class="tile-header">
        <!-- Main title and subtitle passed from the parent dashboard -->
        <h3>@TileData.Title</h3>
        <p class="subtitle">@TileData.Subtitle</p>
    </div>

    <div class="tile-body">
        @if (TileData.IsLoading)
        {
            <!-- Shown while data is being fetched from the backend -->
            <div class="tile-loading">Loading...</div>
        }
        else if (TileData.ErrorMessage != null)
        {
            <!-- Error state - e.g., API failure or network issue -->
            <div class="tile-error">@TileData.ErrorMessage</div>
        }
        else if (TileData.PreviewItems.Count == 0)
        {
            <!-- No data returned after loading -->
            <div class="tile-error">No data available</div>
        }
        else
        {
            <!-- Main content: ordered list of preview items (e.g. top 5 games) -->
            <ol class="tile-list">
                @foreach (var item in TileData.PreviewItems)
                {
                    <li class="tile-list-item">
                        <span class="tile-item-name">@item.Label</span>
                        <span class="tile-item-value">@item.Value</span>
                    </li>
                }
            </ol>
        }
    </div>

    <div class="tile-footer">
        <span class="click-hint">Click to expand →</span>
    </div>
</div>

@code {
    /// <summary>
    /// The data model for this tile (title, subtitle, preview items, loading state, error, etc.).
    /// Passed down from the parent Dashboard component.
    /// </summary>
    [Parameter] 
    public TileInfo TileData { get; set; } = default!;

    /// <summary>
    /// Event callback that notifies the parent when this tile is clicked.
    /// The parent then opens the TileModal with full details.
    /// </summary>
    [Parameter] 
    public EventCallback OnTileClicked { get; set; }

    /// <summary>
    /// Handles click on the entire tile and invokes the callback to the parent.
    /// </summary>
    private async Task HandleClick()
    {
        await OnTileClicked.InvokeAsync();
    }
}